{
	"name": "@template/field-operations",
	"version": "0.0.2",
	"private": true,
	"type": "module",
	"scripts": {
		"dr": "pnpm exec norbital-doctor audit --root .",
		"format": "prettier --write .",
		"lint": "prettier --check . && svelte-check --tsgo-experimental-api --tsconfig ./tsconfig.json",
		"sync": "bolt sync",
		"sync:watch": "bolt sync --watch",
		"test": "bolt sync && norbital-doctor && node --experimental-strip-types --import ./scripts/ts-source-resolve.mjs --import ./scripts/test-artifact-reader.mjs --test 'tests/*.test.ts'",
		"test:e2e": "bolt sync && vitest run --config vitest.e2e.config.ts",
		"test:e2e:headed": "PLAYWRIGHT_HEADED=1 pnpm test:e2e"
	},
	"dependencies": {
		"@iconify/svelte": "^5.2.2",
		"@norbital-ai/bolt": "0.0.97",
		"@norbital-ai/bolt-protocol": "0.0.97",
		"@norbital-ai/std": "0.0.97",
		"@norbital-ai/ui": "0.0.97",
		"effect": "4.0.0-rc.111",
		"exifr": "7.1.3",
		"fast-png": "8.0.0",
		"jpeg-js": "0.4.4",
		"libheif-js": "1.23.2",
		"mode-watcher": "^1.1.0",
		"pdq-wasm": "0.3.9",
		"runed": "^0.37.1",
		"svelte": "^5.56.10",
		"vite": "^8.2.2"
	},
	"devDependencies": {
		"@norbital-ai/bolt-server": "0.0.97",
		"@norbital-ai/test-utilities": "0.0.97",
		"@norbital-ai/doctor": "0.0.97",
		"@types/node": "^26.2.0",
		"@typescript/native": "npm:typescript@7.0.2",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte-check": "^4.7.6",
		"typescript": "6.0.3",
		"vitest": "4.1.11"
	}
}
