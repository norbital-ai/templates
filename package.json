{
	"name": "@norbital-ai/templates",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.22.0",
	"engines": {
		"node": ">=26.0.0"
	},
	"scripts": {
		"check": "pnpm templates:check && pnpm test && pnpm format:check && pnpm templates:lock:check && pnpm templates:verify",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"templates:check": "node --experimental-strip-types scripts/ci.ts check",
		"templates:lock": "node --experimental-strip-types scripts/ci.ts lock",
		"templates:lock:check": "node --experimental-strip-types scripts/ci.ts lock --check",
		"templates:lock:verify": "node --experimental-strip-types scripts/ci.ts lock --check --verify-install",
		"templates:verify": "node --experimental-strip-types scripts/ci.ts verify",
		"test": "node --experimental-strip-types --test scripts/ci.test.ts"
	},
	"devDependencies": {
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.56.10"
	}
}
