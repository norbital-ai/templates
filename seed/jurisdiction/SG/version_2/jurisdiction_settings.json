		"behaviours": {
			"version": 1,
			"rules": [
				{
					"id": "payroll-run",
					"catalog": "WORK",
					"events": ["PAYROLL_CREATE"],
					"when": "event.data.request.kind in [\"REGULAR\", \"OFF_CYCLE\"]"
				},
				{
					"id": "pin-settled-entries",
					"target_collection": "payroll_run",
					"events": ["created"],
					"when": "event.row.approval_id == null",
					"fields": ["pins"],
					"reads": {
						"slips": {
							"collection": "payslip",
							"where": {
								"payroll_run_id": {
									"eq": "event.row.id"
								}
							},
							"select": ["id", "employment_id"]
						}
					},
					"effect": "event.row.pins.map(p, { \"collection\": p.collection, \"operation\": \"update\", \"data\": { \"target\": [p.id], \"set\": { \"payslip_id\": first(slips.filter(s, s.employment_id == p.employment_id).map(s, s.id)) } } }).filter(w, w.data.set.payslip_id != null)"
				},
				{
					"id": "hold-payslips",
					"target_collection": "payroll_run",
					"events": ["created"],
					"when": "event.row.approval_id == null && has(event.row.holds) && event.row.holds != null && size(event.row.holds) > 0",
					"fields": ["holds"],
					"reads": {
						"slips": {
							"collection": "payslip",
							"where": {
								"payroll_run_id": {
									"eq": "event.row.id"
								},
								"status": {
									"eq": "\"DRAFT\""
								}
							},
							"select": ["id", "employment_id"]
						}
					},
					"effect": "event.row.holds.map(h, { \"collection\": \"payslip\", \"operation\": \"update\", \"data\": { \"target\": slips.filter(s, s.employment_id == h.employment_id).map(s, s.id), \"set\": { \"status\": \"ON_HOLD\" } } }).filter(w, size(w.data.target) > 0)"
				},
				{
					"id": "encash-leave-on-exit",
					"target_collection": "employment_contract",
					"events": ["updated"],
					"when": "event.row.approval_id == null && event.row.exit_facts != null && event.row.effective_range.to != null && !(event.row.exit_ground == \"DISMISSAL\" && has(event.row.exit_facts.dismissed_for_misconduct) && event.row.exit_facts.dismissed_for_misconduct == true)",
					"fields": ["exit_facts", "effective_range"],
					"reads": {
						"catalogues": {
							"collection": "leave_catalog",
							"where": {
								"settings_id": {
									"eq": "event.settings_id"
								},
								"encash_on_exit": {
									"eq": true
								}
							},
							"select": ["id", "code", "unit", "entitlement"]
						},
						"movements": {
							"collection": "leave_catalog_entry",
							"where": {
								"employment_id": {
									"eq": "event.row.id"
								}
							},
							"select": ["catalog_id", "activity", "days", "reference"]
						}
					},
					"effect": "catalogues.filter(c, has(c.entitlement) && c.entitlement != null && has(c.entitlement.days) && !movements.exists(m, m.reference == \"exit:\" + event.row.id + \":\" + c.code)).map(c, { \"collection\": \"leave_catalog_entry\", \"operation\": \"create\", \"data\": { \"catalog_id\": c.id, \"employment_id\": event.row.id, \"occurred_on\": event.row.effective_range.to, \"activity\": \"ENCASHMENT\", \"reference\": \"exit:\" + event.row.id + \":\" + c.code, \"days\": max(0.0, sum(event.leave_balances.filter(b, b.code == c.code).map(b, b.available))), \"incurred_on\": event.row.effective_range.to } }).filter(w, w.data.days > 0)"
				},
				{
					"id": "raise-obligations",
					"target_collection": "payroll_run",
					"events": ["created"],
					"when": "event.row.approval_id == null",
					"fields": ["period", "company_id"],
