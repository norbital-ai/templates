[
	{
		"id": "0ab8173d-f70a-53c0-8520-bddc058fdc6f",
		"settings_id": "c0662f63-462e-553e-94fc-b91f789ec5f1",
		"code": "BASIC",
		"name": "Basic salary",
		"component_code": "BASIC",
		"quantity": "period.paid_days / period.days",
		"rate": "terms.base_salary / double(period.parts)",
		"eligibility": "true",
		"destination": "PAY",
		"direction": "ADD",
		"counts_toward": [
			"LI",
			"EI",
			"NHI",
			"NHI_SUPPLEMENT",
			"LABOR_PENSION",
			"OCC_INJURY",
			"WAGE_ARREARS_FUND",
			"INCOME_TAX",
			"INCOME_TAX_NON_RESIDENT",
			"WELFARE_FUND",
			"LABOR_PENSION_RESERVE",
			"NHI_PART_TIME"
		],
		"prorated": true
	},
	{
		"id": "f0474f29-8c86-5b69-b274-26995bf5c41a",
		"settings_id": "c0662f63-462e-553e-94fc-b91f789ec5f1",
		"code": "OVERTIME",
		"name": "Overtime (平日延長工時)",
		"component_code": "OVERTIME",
		"quantity": "sum(work.days.filter(d, !(d.day_type in [\"REST\", \"OFF\"]) && d.holiday_kind == \"\" && d.overtime_hours > 0.0).map(d, 1.34 * min(d.overtime_hours, 2.0) + 1.67 * max(0.0, d.overtime_hours - 2.0)))",
		"rate": "(terms.monthly_wage / 30.0 / 8.0)",
		"eligibility": "work.days.exists(d, !(d.day_type in [\"REST\", \"OFF\"]) && d.holiday_kind == \"\" && d.overtime_hours > 0.0)",
		"destination": "PAY",
		"direction": "ADD",
		"counts_toward": [],
		"authority": "勞動基準法 §24(1): 延長工作時間在二小時以內者，按平日每小時工資額加給三分之一以上；再延長工作時間在二小時以內者，加給三分之二以上 — each working day’s approved overtime hours (work.days[].overtime_hours), the first two at 1.34 and every further hour at 1.67 of the hourly wage (monthly wage incl. regular allowances ÷ 30 ÷ 8). Within the §32 limits it is not taxable salary (所得稅法 §14(1)(3)). (https://law.moj.gov.tw/LawClass/LawSingle.aspx?pcode=N0030001&flno=24)"
	},
	{
		"id": "0fdc86dd-befd-5f65-8f30-cfe523bb3ece",
		"settings_id": "c0662f63-462e-553e-94fc-b91f789ec5f1",
		"code": "STATUTORY_REST_WORK",
		"name": "Work on the regular day off (例假工作)",
		"component_code": "STATUTORY_REST_WORK",
		"quantity": "double(size(work.days.filter(d, d.day_type == \"REST\" && d.holiday_kind == \"\" && d.worked_hours > 0.0)))",
		"rate": "terms.monthly_wage / 30.0",
		"eligibility": "work.days.exists(d, d.day_type == \"REST\" && d.holiday_kind == \"\" && d.worked_hours > 0.0)",
		"destination": "PAY",
		"direction": "ADD",
		"counts_toward": [],
		"authority": "勞動基準法 §40(1): 因天災、事變或突發事件…停止第三十六條至第三十八條所定勞工之假期。但停止假期之工資，應加倍發給，並應於事後補假休息 — one further day’s wage for each worked day whose shift is REST (the §36 例假); the rest in lieu is STATUTORY_REST_IN_LIEU. Work on a 例假 outside §40 is unlawful but its wage is still owed. (https://law.moj.gov.tw/LawClass/LawSingle.aspx?pcode=N0030001&flno=40)"
	},
	{
		"id": "f7f9a8aa-edb4-5b91-8261-87a9f10a9b70",
		"settings_id": "c0662f63-462e-553e-94fc-b91f789ec5f1",
		"code": "REST_DAY_WORK",
		"name": "Rest-day work (休息日工作)",
		"component_code": "REST_DAY_WORK",
		"quantity": "sum(work.days.filter(d, d.day_type == \"OFF\" && d.holiday_kind == \"\" && d.worked_hours > 0.0).map(d, 1.34 * min(d.worked_hours, 2.0) + 1.67 * max(0.0, min(d.worked_hours, 8.0) - 2.0) + 2.67 * max(0.0, d.worked_hours - 8.0)))",
		"rate": "(terms.monthly_wage / 30.0 / 8.0)",
		"eligibility": "work.days.exists(d, d.day_type == \"OFF\" && d.holiday_kind == \"\" && d.worked_hours > 0.0)",
		"destination": "PAY",
		"direction": "ADD",
		"counts_toward": [],
		"authority": "勞動基準法 §24(2): 休息日工作，工作時間在二小時以內者，加給一又三分之一以上；第三小時至第八小時，加給一又三分之二以上；第九小時至第十二小時，加給二又三分之二以上 — the hours actually worked (the minimum-count rule was deleted 2018-03-01) on a day whose shift is OFF, the TW 休息日 (shift_definition.variant.day_type OFF; REST is the §36 例假). (https://law.moj.gov.tw/LawClass/LawSingle.aspx?pcode=N0030001&flno=24)"
	},
	{
		"id": "a92d9ec8-f79c-5e89-bcb1-9d50df56e572",
		"settings_id": "c0662f63-462e-553e-94fc-b91f789ec5f1",
		"code": "NO_PAY_LEAVE",
		"name": "No-pay leave",
		"component_code": "NO_PAY_LEAVE",
		"quantity": "sum(leave.rows.filter(r, r.is_npl && r.activity == \"TIME_OFF\").map(r, r.days))",
		"rate": "terms.base_salary / 30.0",
		"eligibility": "leave.rows.exists(r, r.is_npl && r.activity == \"TIME_OFF\" && r.days > 0.0)",
		"destination": "PAY",
		"direction": "SUBTRACT",
		"counts_toward": [
			"LI",
			"EI",
			"NHI",
			"NHI_SUPPLEMENT",
			"LABOR_PENSION",
			"OCC_INJURY",
			"WAGE_ARREARS_FUND",
			"INCOME_TAX",
			"INCOME_TAX_NON_RESIDENT",
			"WELFARE_FUND",
			"LABOR_PENSION_RESERVE",
			"NHI_PART_TIME"
		]
	},
	{
		"id": "03fc33d8-e71c-5dfe-a7d7-7428d9b2df34",
		"settings_id": "c0662f63-462e-553e-94fc-b91f789ec5f1",
		"code": "PARTIAL_PAY_LEAVE",
		"name": "Partial-pay leave",
		"component_code": "PARTIAL_PAY_LEAVE",
		"quantity": "sum(leave.rows.filter(r, !r.is_npl && r.activity == \"TIME_OFF\" && r.pay_fraction < 1.0).map(r, r.days * (1.0 - r.pay_fraction)))",
		"rate": "terms.base_salary / 30.0",
		"eligibility": "leave.rows.exists(r, !r.is_npl && r.activity == \"TIME_OFF\" && r.pay_fraction < 1.0 && r.days > 0.0)",
		"destination": "PAY",
		"direction": "SUBTRACT",
		"counts_toward": [
			"LI",
			"EI",
			"NHI",
			"NHI_SUPPLEMENT",
			"LABOR_PENSION",
			"OCC_INJURY",
			"WAGE_ARREARS_FUND",
			"INCOME_TAX",
			"INCOME_TAX_NON_RESIDENT"
		],
		"authority": "The unpaid part of a leave class paid below full wage, from its own pay_fraction evaluated per leave row: 勞工請假規則 §4(3) sickness at half pay within thirty days a year; 性別平等工作法 §14 menstrual leave at half pay; 勞動基準法 §50(2) maternity at half pay under six months’ service, and the unpaid early-miscarriage leaves (性別平等工作法 §15(1)). (https://law.moj.gov.tw/LawClass/LawSingle.aspx?pcode=N0030006&flno=4)"
	},
	{
		"id": "7a5c9c32-e7df-5dfa-9d7d-f053d4f06ed8",
		"settings_id": "c0662f63-462e-553e-94fc-b91f789ec5f1",
		"code": "ENCASHMENT",
		"name": "Leave encashment",
		"component_code": "ENCASHMENT",
		"quantity": "sum(leave.rows.filter(r, r.can_encash && r.activity == \"ENCASHMENT\").map(r, r.days))",
		"rate": "terms.base_salary / 30.0",
		"eligibility": "leave.rows.exists(r, r.can_encash && r.activity == \"ENCASHMENT\" && r.days > 0.0)",
		"destination": "PAY",
		"direction": "ADD",
		"counts_toward": ["INCOME_TAX_BONUS", "INCOME_TAX_NON_RESIDENT", "NHI_PART_TIME"]
	},
	{
		"id": "02a0de50-aebf-5c22-95b5-a59f9d13d8a2",
		"settings_id": "c0662f63-462e-553e-94fc-b91f789ec5f1",
		"code": "HOLIDAY_WORK",
		"name": "Public-holiday work",
		"component_code": "HOLIDAY_WORK",
		"quantity": "round(double(size(work.holidays.filter(h, h.kind in [\"PUBLIC_HOLIDAY\", \"SUBSTITUTE\", \"DOUBLE_HOLIDAY\"] && (h.given_to != \"ONLY_IF_OFF_ON_REPLACED_DATE\" || (h.replaces != \"\" && !(h.replaces in work.dates)))))), 1.0, \"UP\")",
		"rate": "terms.base_salary / 30.0",
		"eligibility": "(8.0 * double(size(work.holidays.filter(h, h.kind in [\"PUBLIC_HOLIDAY\", \"SUBSTITUTE\", \"DOUBLE_HOLIDAY\"] && (h.given_to != \"ONLY_IF_OFF_ON_REPLACED_DATE\" || (h.replaces != \"\" && !(h.replaces in work.dates))))))) > 0.0",
		"destination": "PAY",
		"direction": "ADD",
		"counts_toward": []
	}
]
