						"race": {
							"type": "string",
							"description": "The employee’s race as CPF records it (for example CHINESE, MALAY, INDIAN, EURASIAN): the CDAC, ECF and SINDA self-help-group funds read it (CPF Act 1953 s.77(1)(p))."
						},
