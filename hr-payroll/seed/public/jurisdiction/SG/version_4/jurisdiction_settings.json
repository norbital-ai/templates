											"properties": {
												"shg_monthly_amount": {
													"type": "number",
													"minimum": 0,
													"description": "A changed monthly contribution the employee instructed through the fund, in place of the schedule amount, on that fund’s standing."
												},
												"shg_opted_out": {
													"type": "boolean",
													"default": false,
													"description": "CPF Board, Contributions to self-help groups: an employee who opts out of a fund in writing (the fund’s form) stops its deduction from the effective date recorded as the standing’s effective_range.from. Set on that fund’s standing (CDAC, ECF, MBMF or SINDA)."
												}
