							"type": "boolean",
							"description": "A sole parent: the shared parental leave pool defaults to the whole pool on an individual arrangement (Child Development Co-Savings Act 2001 ss.12DA–12DD)."
						},
						"annual_leave_unpaid_service_policy": {
							"type": "string",
							"enum": ["COUNT_APPROVED_UNPAID", "EXCLUDE_REQUIRES_REVIEW"],
							"description": "COUNT_APPROVED_UNPAID expressly grants the more generous entitlement. The excluded-service path requires reviewed qualifying-service allocation and is refused instead of using raw calendar months. The seed otherwise grants the more generous calendar-service annual entitlement, counting approved unpaid service; it never silently applies an exclusion."
						},
						"leave_year_employment_basis": {
							"type": "string",
							"enum": ["CONTINUOUS_SAME_BASIS", "MIXED_REQUIRES_REVIEW"],
							"description": "Mixed full/part-time service in a leave year needs reviewed entitlement allocation, including a worker now full-time."
						},
						"comparable_full_time_hours_per_day": {
							"type": "number",
							"exclusiveMinimum": 0,
							"maximum": 24,
							"description": "Normal daily hours of a comparable full-time employee (default 8, EA s.38(1)(b)). Customer input."
						},
						"comparable_full_time_hours_per_week": {
							"type": "number",
							"exclusiveMinimum": 0,
							"maximum": 168,
