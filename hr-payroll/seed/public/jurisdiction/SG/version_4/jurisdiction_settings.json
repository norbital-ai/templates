				"exit_facts": {
					"type": "object",
					"additionalProperties": false,
					"description": "Stored in the contract's employee extension data when the contract closes.",
					"properties": {
						"dismissed_for_misconduct": {
							"type": "boolean",
							"default": false,
							"title": "Dismissed for misconduct after due inquiry",
							"description": "Employment Act 1968 s.14(1) (due inquiry) with s.88A: untaken annual leave is paid on every exit except a DISMISSAL for misconduct; the encash-leave-on-exit rule withholds it when this is true on a DISMISSAL."
						},
						"final_pay_not_possible": {
							"type": "boolean",
							"title": "Pay on the dismissal day not possible",
							"description": "Employment Act 1968 s.22: then within 3 days, excluding rest days and public holidays."
						},
						"eap_decision": {
							"type": "string",
							"enum": ["AWARD", "NOT_AWARDED"],
							"description": "Retirement and Re-employment Act 1993 s.7C: AWARD when an eligible employee could not be re-employed and no alternate-employer offer was accepted; EMPLOYMENT_ASSISTANCE_PAYMENT is offered only then."
						},
						"ir21_clearance_on": {
							"type": "string",
							"format": "date",
							"title": "IRAS tax clearance received on",
							"description": "Income Tax Act 1947 s.68(7) / EA s.24: the day the Comptroller’s clearance (or permission to pay) arrived; until it is recorded the final pay of a non-Citizen is held (IR21_FINAL_PAY_HOLD)."
						},
						"ir21_exemption": {
							"type": "string",
							"enum": ["SPR_UNDERTAKING", "SHORT_STINT_60_DAYS", "BELOW_21000"],
							"description": "IRAS, Tax clearance for employees: no IR21 for an SPR not leaving Singapore permanently who gives a letter of undertaking, for an employment of 60 days or less (not a director), or for income below $21,000 a year under the IRAS conditions. Recorded, the IR21 task is not raised and the final pay is released. Customer input."
						},
						"ir21_additional_clearance_on": {
							"type": "string",
							"format": "date",
							"title": "IRAS clearance of the Additional/Amended IR21 received on",
							"description": "Income Tax Act 1947 s.68(7); IRAS, Tax clearance for employees: a payment after the IR21 clearance waits for clearance of an Additional/Amended Form IR21; until this is recorded such a payment is held (IR21_ADDITIONAL_PAYMENT_HOLD)."
						},
						"ir21_additional_cleared_month": {
							"type": "string",
							"pattern": "^[0-9]{4}-[0-9]{2}$",
							"description": "Salary month whose cumulative gross additional/final income is covered by the Additional/Amended IR21 directive."
						},
						"ir21_additional_cleared_month_gross": {
							"type": "number",
							"minimum": 0,
							"description": "Maximum cumulative gross wages in that salary month covered by the directive, including earlier slips of the month."
						},
						"ir21_additional_clearance_evidence": {
							"type": "string",
							"minLength": 1
						}
					},
					"title": "Departure compliance details"
				}
			},
			"description": "Additional local compliance facts on the sealed contract. facts is payroll.facts; term_facts is terms.facts; exit_facts is the departure facts. Shared salary, allowances, work classifications, dates and work arrangements are native fields."
		},
		"entity_extension_schema": {
			"$schema": "https://json-schema.org/draft/2020-12/schema",
			"type": "object",
			"title": "SG entity inputs",
			"additionalProperties": false,
			"properties": {
				"ns_direct_scheme": {
					"type": "boolean",
					"description": "Registered for MINDEF/MHA DIRECT (Direct Reimbursement to Employers of Claims for NS Training): the employer keeps paying wages during NS training and is reimbursed (NS_LEAVE paid_share 1); otherwise NS days are an incomplete month under EA s.20A(1)(d) (paid_share 0). Customer input."
				},
				"industrial_undertaking": {
					"type": "boolean",
					"description": "The entity is an industrial undertaking (EA s.2) for the young-person notification. Customer input."
				},
				"data_protection_officer_contact": {
					"type": "string",
					"minLength": 1,
					"description": "Name and contact of the designated data protection officer (PDPA 2012 s.11(3)). Customer input."
				}
			}
		},
		"lookup": {
			"month_balance": [
				"BASIC",
				"ORDINARY_WAGES",
				"ADDITIONAL_WAGES",
				"CPF.employee",
				"CPF.employer",
				"SDL.employer",
				"CDAC.employee",
				"ECF.employee",
				"MBMF.employee",
				"SINDA.employee",
				"CPF_AW.employer"
			],
			"rounding": "HALF_UP",
			"rounding_scale": 2,
			"statutory_work_categories": ["NON_MANUAL", "MANUAL_LABOUR", "MANUAL_LABOUR_SUPERVISOR"],
			"months_per_year": 12,
			"day_rate": "// Basic day rate, what EA ss.37 and 88(4) pay on: MOM, 12 × monthly basic ÷ (52 × days required a week). Proration: EA s.20A and MOM, monthly gross ÷ days required to work in that month × days worked, so WORKING_DAYS in every version.\nconst terms = ctx.subject.employment.terms;\nconst unit = get(terms, 'rate.unit', 'MONTHLY');\nconst amount = Number(get(terms, 'rate.amount', 0));\nconst hours = Number(get(terms, 'normal_hours_per_day', 8));\nif (unit === 'DAILY') return amount;\nif (unit === 'HOURLY' || unit === 'PIECE') return amount * hours;\nreturn (amount * 12) / (52 * Number(get(terms, 'normal_days_per_week', 5)));",
			"proration_basis": "WORKING_DAYS",
			"rounding_step": 1.0,
			"weeks_per_year": 52,
			"covered_engagements": ["EMPLOYEE", "PART_TIME", "INTERN", "APPRENTICE"],
			"local_residencies": ["CITIZEN", "PERMANENT_RESIDENT"],
			"work_pass_categories": ["WORK_PERMIT", "S_PASS", "EMPLOYMENT_PASS"],
			"daily_hours": 12,
			"manual_categories": ["MANUAL_LABOUR", "MANUAL_LABOUR_SUPERVISOR"],
			"manual_monthly_ceiling": 4500,
			"nonmanual_monthly_ceiling": 2600,
			"full_time_weekly_hours": 44,
			"full_time_minimum_hours": 35,
			"holiday_kinds": ["PUBLIC_HOLIDAY", "SUBSTITUTE"],
			"ordinary_ceiling": 8000.0,
			"annual_ceiling": 102000.0,
