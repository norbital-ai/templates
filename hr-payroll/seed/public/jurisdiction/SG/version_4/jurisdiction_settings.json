				},
				{
					"phase": "full",
					"age": 60,
					"key": "r16"
				},
				{
					"phase": "full",
					"age": 65,
					"key": "r17"
				},
				{
					"phase": "full",
					"age": 70,
					"key": "r5"
				},
				{
					"phase": "first_year",
					"age": 0,
					"key": "r9"
				},
				{
					"phase": "first_year",
					"age": 60,
					"key": "r10"
