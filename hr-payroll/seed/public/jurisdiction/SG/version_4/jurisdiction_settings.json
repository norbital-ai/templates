		"employee_extension_schema": {
			"$schema": "https://json-schema.org/draft/2020-12/schema",
			"type": "object",
			"title": "SG employee inputs",
			"additionalProperties": false,
			"properties": {
				"facts": {
					"type": "object",
					"additionalProperties": false,
					"description": "Employee facts and statutory declarations captured on the sealed contract's employee extension data.",
					"properties": {
						"tax_resident": {
							"type": "boolean",
							"description": "Income Tax Act 1947 s.2: Singapore tax resident. A non-resident director’s fees are withheld at 24% (WHT_NR_DIRECTOR). Customer input."
						},
						"student_training_class": {
							"type": "string",
							"enum": ["NONE", "LOCAL_APPROVED_TRAINING", "OTHER_REQUIRES_REVIEW"],
							"description": "Required for INTERN. NONE means no student-training exemption is claimed; an internship label alone does not exempt. LOCAL_APPROVED_TRAINING requires the institution approval, MOE-subsidy answer, dates and documentary reference below. Other student exemption classes require separately reviewed treatment. OTHER_REQUIRES_REVIEW covers other claimed student exemptions, including overseas-required training or school-holiday cases: their evidence/wage allocation is reviewed before payroll."
						},
						"student_training_institution": {
							"type": "string",
							"enum": [
								"ITE",
								"NYP",
								"NTU",
								"NUS",
								"NP",
								"RP",
								"SIT",
								"SMU",
								"SP",
								"SUSS",
								"SUTD",
								"TP",
								"OTHER"
							],
							"description": "Institution of a registered/matriculated student in documented institution-approved training. SDL uses the twelve named local institutions; MBMF uses the nine local institutions in MUIS Student Pay guidance. OTHER does not infer either exemption."
						},
						"student_training_moe_subsidised": {
							"type": "boolean",
							"description": "The student is enrolled in an MOE-subsidised institution or programme, evidenced by the institution: required for the CPF and CDAC/ECF/SINDA approved-training exemption. A false answer retains those charges."
						},
						"student_training_approved": {
							"type": "boolean",
							"description": "The educational institution has approved this training (including an evidenced approved extension). A claimed approved-training exemption requires true."
						},
						"student_training_from": {
							"type": "string",
							"format": "date",
							"description": "First date covered by the institution-approved training evidence. A claim must cover every employed date in the assessed calendar month; a mixed month is refused pending reviewed wage allocation."
						},
						"student_training_to": {
							"type": "string",
							"format": "date",
							"description": "Last date covered by the institution-approved training evidence, including documented approved extensions."
						},
						"student_training_evidence": {
							"type": "string",
							"minLength": 1,
							"description": "Retained institutional approval/registration document reference. Classification and dates without this evidence do not exempt."
						},
						"part_time_leave_basis": {
							"type": "string",
							"enum": ["CONTINUOUS_PART_TIME", "MIXED_REQUIRES_REVIEW"],
							"description": "Confirm continuous part-time service in the leave year. Mixed full/part-time service years require reviewed allocation and are refused rather than granted from current hours."
						},
						"no_similar_full_time_employee": {
							"type": "boolean",
							"description": "True only when no similar full-time employee exists: Part-Time Regulations reg.2(2) then supplies 8 daily/44 weekly hours. Otherwise declare the actual comparable full-time daily and weekly hours."
						},
						"part_time_annual_encashment_agreed": {
							"type": "boolean",
							"description": "Clear contractual agreement to include earned annual leave in hourly gross pay. Does not permit ongoing encashment for a worker on at least five days/week and 30-34 hours/week."
						},
						"ir21_departure_clearance_on": {
							"type": "string",
							"format": "date"
						},
						"ir21_departure_clearance_through": {
							"type": "string",
							"format": "date",
							"description": "Last salary-period date/income covered by the documentary IRAS departure clearance."
						},
						"ir21_departure_clearance_evidence": {
							"type": "string",
							"minLength": 1
						},
						"ir21_departure_exemption_evidence": {
							"type": "string",
							"minLength": 1,
							"description": "Documented IRAS departure exception, including its conditions. A mere immigration label is not an exemption."
						},
						"pt_leave_hourly_uplift_evidence": {
							"type": "string",
							"minLength": 1,
							"description": "Documented agreed annual-leave hourly uplift computation and OW/AW classification for the PT_ANNUAL_HOURLY allowance; statutory leave is not silently forfeited."
						},
						"statutory": {
							"type": "object",
							"title": "Statutory declarations",
							"additionalProperties": false,
							"description": "Employee registrations, exemptions and declared choices captured on this sealed contract.",
							"properties": {
								"CPF": {
