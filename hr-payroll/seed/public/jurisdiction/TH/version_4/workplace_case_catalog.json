	{
		"code": "DEDUCTION_LIMIT_CONSENT",
		"name": "Employee’s prior written consent to specified deductions",
		"off_cycle_eligible": false,
		"lookup": {
			"input_schema": {
				"type": "object",
				"properties": {
					"effective_from": {
						"type": "string",
						"format": "date",
						"title": "Requested effective first day"
					},
					"effective_to": {
						"type": "string",
						"format": "date",
						"title": "Requested effective last day"
					},
					"signed_on": {
						"type": "string",
						"format": "date"
					},
					"currency": {
						"type": "string",
						"minLength": 1
					},
					"deductions": {
						"type": "array",
						"minItems": 1,
						"items": {
							"type": "object",
							"properties": {
								"code": {
									"type": "string",
									"enum": ["WELFARE_LOAN", "PVD"]
								},
								"maximum_amount": {
									"type": "number",
									"exclusiveMinimum": 0
								}
							},
							"additionalProperties": false,
							"required": ["code", "maximum_amount"]
						}
					}
				},
				"additionalProperties": false,
				"required": ["effective_from", "effective_to", "signed_on", "currency", "deductions"],
				"description": "The actual signed consent states each deduction, its amount limit and applicable payment interval. It does not authorise every deduction forever; reference and written evidence identify the signed document. Close on withdrawal."
			}
		},
