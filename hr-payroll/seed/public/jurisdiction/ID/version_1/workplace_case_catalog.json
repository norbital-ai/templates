	{
		"code": "BENEFIT_SERVICE_RECORD",
		"lookup": {
			"input_schema": {
				"type": "object",
				"properties": {
					"benefit_reference": {
						"type": "string",
						"minLength": 1,
						"title": "Actual benefit/award reference"
					},
					"service_period": {
						"$ref": "#/$defs/period"
					},
					"country": {
						"$ref": "#/$defs/country"
					},
					"service_employer": {
						"$ref": "#/$defs/party"
					}
				},
				"additionalProperties": false,
