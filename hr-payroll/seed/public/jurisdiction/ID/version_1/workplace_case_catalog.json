	{
		"code": "EXTERNAL_WAGE_RECORD",
		"name": "Original external wage payment or cost allocation",
		"lookup": {
			"input_schema": {
				"type": "object",
				"properties": {
					"record_type": {
						"type": "string",
						"enum": ["PAYMENT", "COST_ALLOCATION"],
						"title": "Original record type"
					},
					"original_payment_reference": {
						"type": "string",
						"minLength": 1,
						"title": "Original wage payment reference",
						"description": "For PAYMENT, the unique actual payment/source reference. For COST_ALLOCATION, the original payment to which the actual recharge/allocation relates."
					},
					"earned_period": {
						"$ref": "#/$defs/period"
					},
					"component_code": {
						"type": "string",
						"minLength": 1,
						"title": "Original wage/benefit component code"
					},
					"amount": {
						"type": "number",
						"title": "Original amount",
						"description": "The actual signed source amount. Record original payments and source-documented corrections separately; never enter a calculated domestic share or percentage."
					},
					"currency": {
						"type": "string",
						"pattern": "^[A-Z]{3}$",
						"title": "Original currency",
						"description": "The actual original ISO4217 source currency. Do not convert it into payroll currency while capturing the record."
					},
					"payer": {
						"$ref": "#/$defs/party"
					},
					"service_beneficiary": {
						"$ref": "#/$defs/party"
					},
					"cost_bearer": {
						"$ref": "#/$defs/party"
					},
					"reverses_reference": {
						"type": "string",
						"minLength": 1,
						"title": "Original record being corrected/reversed"
					}
				},
				"additionalProperties": false,
				"required": [
					"record_type",
					"original_payment_reference",
					"earned_period",
					"component_code",
					"amount",
					"currency",
					"payer",
					"service_beneficiary"
				],
				"description": "One actual source payment/component or actual issued cost allocation. opened_on is the actual paid date for PAYMENT, or actual allocation-issued date for COST_ALLOCATION; allocation is never payment proof. Payer is who paid the original remuneration, service beneficiary is the entity receiving the work, and cost bearer is the entity charged the actual allocated amount. The employee is the native case employment. Current-workspace payslips and same-employer prior_payroll records must not be duplicated here.",
