[
	{
		"code": "BASIC",
		"name": "Basic pay",
		"previous_id": null,
		"id": "cde9f8f5-3e1b-585a-b2cf-e359fc6e8bff",
		"settings_id": "b256a118-49fe-537d-9404-ccfe47bc234c",
		"calculation": "// js\n// Labor Code art.103: a monthly salary paid twice a month pays half each run. A day rate pays the working days of the period,\n// less the holidays that HOLIDAY_WORK, SPECIAL_HOLIDAY_WORK and DAILY_HOLIDAY_PAY price at their own full multiple; an unworked\n// special day is no work, no pay. ctx.base_pay has already taken off unpaid days, joiners and leavers.\nconst terms = ctx.subject.employment.terms;\nconst employer = ctx.subject.employer;\nconst coverage = ctx.run.salary_coverage;\nconst unit = get(terms, 'rate.unit', 'MONTHLY');\nif (unit === 'MONTHLY') return get(employer, 'payment_schedule.frequency', '') === 'SEMI_MONTHLY' ? ctx.base_pay / 2 : ctx.base_pay;\nif (unit !== 'DAILY' || [\"MANAGERIAL\", \"DOMESTIC\", \"FIELD_PERSONNEL\", \"TASK_BASIS\", \"PIECE_RATE\"].includes(get(terms, 'statutory_work_category', ''))) return ctx.base_pay;\nconst facts = get(employer, 'entity_extension_data', {});\nconst off = get(employer, 'payment_schedule.non_working_weekdays', [0, 6]);\nconst small = get(facts, 'retail_or_service_establishment', false) === true && get(facts, 'small_establishment', false) === true;\nconst priced = ctx.work.days.filter((d) => {\n\tconst kind = get(d, 'holiday_kind', '');\n\t// Every holiday kind except MAKEUP_WORKDAY earns the premium; a makeup workday is a plain working day.\n\tif (kind === '' || kind === 'MAKEUP_WORKDAY' || get(d, 'day_type', '') !== 'WORK') return false;\n\tif (d.date < coverage.from || d.date > coverage.to || off.includes(weekday(d.date))) return false;\n\tconst special = kind === 'SPECIAL_HOLIDAY' || kind === 'DOUBLE_SPECIAL';\n\treturn special || !small;\n}).length;\nreturn Math.max(0, ctx.base_pay - ctx.day_rate * priced);",
		"balance_window": "MONTH"
	},
