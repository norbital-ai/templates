[
	{
		"id": "65a02b7a-49f1-5f93-b6ba-9e61bc5fd99d",
		"code": "OCBC_SG_FAST",
		"name": "OCBC Singapore FAST payroll",
		"bank_codes": ["OCBCSGSGXXX"],
		"currencies": ["SGD"],
		"enabled": true,
		"template": {
			"description": "OCBC Singapore GIRO/FAST bulk payment text file for ordinary salary credits (purpose SALA), following the owner's own OCBC upload: one 1,000-character header (transaction type 30, submission date YYYYMMDD, payer BIC and account, FAST clearing, value date DDMMYYYY) and one 1,000-character detail per payable employee (beneficiary BIC, account, account holder, amount in cents). LF line endings, no trailer record. PayNow, invoice and management-payroll records are not produced.",
			"bank_file_validation": {
				"file": [
					{
						"test": "size(runs) == 1",
						"message": "Export one payroll run per OCBC FAST file."
					},
					{
						"test": "company.disbursement_account.bank_code == \"OCBCSGSGXXX\"",
						"message": "The paying account must use the OCBC Singapore bank code OCBCSGSGXXX."
					},
					{
						"test": "company.disbursement_account.bank_account_number.matches(\"^[A-Za-z0-9]{1,34}$\")",
						"message": "Enter the complete company account number using at most 34 letters or digits, without spaces or separators."
					},
					{
						"test": "generated_at.matches(\"^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*$\")",
						"message": "A valid generation timestamp is required for the OCBC submission date."
					}
				],
				"row": [
					{
						"test": "contract.bank.bank_code.matches(\"^[A-Z]{4}SG[A-Z0-9]{2}XXX$\")",
						"message": "Use the employee bank's complete 11-character Singapore BIC ending XXX."
					},
					{
						"test": "contract.bank.bank_account_number.matches(\"^[A-Za-z0-9]{1,34}$\")",
						"message": "Enter the complete employee account number using at most 34 letters or digits, without spaces or separators."
					},
					{
						"test": "contract.bank.bank_account_name.matches(\"^[ -~]{1,35}$\")",
						"message": "FAST account-holder names must contain 1 to 35 printable ASCII characters. Confirm the bank-approved spelling."
					},
					{
						"test": "size(slips) > 0 && slips.all(s, s.net > 0.0 && s.net == round(s.net, 0.01) && s.status != \"ON_HOLD\") && sum(slips.map(s, s.net)) <= 200000.0",
						"message": "Each employee payment must be positive, contain no fractions of a cent, be payable, and not exceed the SGD 200,000 FAST limit."
					}
				]
			},
			"applies_when": "has(company.disbursement_account) && company.disbursement_account != null && has(company.disbursement_account.bank_code) && company.disbursement_account.bank_code == \"OCBCSGSGXXX\"",
			"file": "\"OCBC-FAST-payroll-\" + runs[0].period + \".txt\"",
			"format": "FIXED",
			"when": "totals.net > 0.0 && !slips.exists(s, s.status == \"ON_HOLD\")",
			"header": [
				{
					"header": "transaction_type",
					"value": "\"30\"",
					"width": 2
				},
				{
					"header": "batch_number",
					"value": "\"\"",
					"width": 3
				},
				{
					"header": "submission_date_yyyymmdd",
					"value": "generated_at.substring(0, 4) + generated_at.substring(5, 7) + generated_at.substring(8, 10)",
					"width": 8
				},
				{
					"header": "originating_bank_code",
					"value": "company.disbursement_account.bank_code",
					"width": 11
				},
				{
					"header": "company_account_number",
					"value": "company.disbursement_account.bank_account_number",
					"width": 34
				},
				{
					"header": "filler_59_61",
					"value": "\"\"",
					"width": 3
				},
				{
					"header": "on_behalf_of",
					"value": "\"\"",
					"width": 20
				},
				{
					"header": "filler_82_201",
					"value": "\"\"",
					"width": 120
				},
				{
					"header": "charge_bearer",
					"value": "\"\"",
					"width": 4
				},
				{
					"header": "clearing",
					"value": "\"FAST\"",
					"width": 4
				},
				{
					"header": "company_reference",
					"value": "\"\"",
					"width": 16
				},
				{
					"header": "value_date_ddmmyyyy",
					"value": "runs[0].pay_date.substring(8, 10) + runs[0].pay_date.substring(5, 7) + runs[0].pay_date.substring(0, 4)",
					"width": 8
				},
				{
					"header": "value_time",
					"value": "\"\"",
					"width": 4
				},
				{
					"header": "batch_booking",
					"value": "\"\"",
					"width": 1
				},
				{
					"header": "filler_239_1000",
					"value": "\"\"",
					"width": 762
				}
			],
			"columns": [
				{
					"header": "employee_bank_bic",
					"value": "contract.bank.bank_code",
					"width": 11
				},
				{
					"header": "employee_account_number",
					"value": "contract.bank.bank_account_number",
					"width": 34
				},
				{
					"header": "employee_account_holder",
					"value": "contract.bank.bank_account_name",
					"width": 35
				},
				{
					"header": "unused_fast_name_positions",
					"value": "\"\"",
					"width": 105
				},
				{
					"header": "currency",
					"value": "\"\"",
					"width": 3
				},
				{
					"header": "amount_cents",
					"value": "string(int(round(totals.net * 100.0, 1.0)))",
					"width": 17,
					"align": "right",
					"pad": "0"
				},
				{
					"header": "payment_details",
					"value": "\"\"",
					"width": 35
				},
				{
					"header": "purpose_code",
					"value": "\"SALA\"",
					"width": 4
				},
				{
					"header": "debtors_reference",
					"value": "\"\"",
					"width": 35
				},
				{
					"header": "ultimate_creditor",
					"value": "\"\"",
					"width": 140
				},
				{
					"header": "ultimate_debtor",
					"value": "\"\"",
					"width": 140
				},
				{
					"header": "remittance_mode",
					"value": "\"\"",
					"width": 1
				},
				{
					"header": "remittance_details",
					"value": "\"\"",
					"width": 255
				},
				{
					"header": "paynow_proxy_type",
					"value": "\"\"",
					"width": 12
				},
				{
					"header": "paynow_proxy_value",
					"value": "\"\"",
					"width": 140
				},
				{
					"header": "filler_968_1000",
					"value": "\"\"",
					"width": 33
				}
			]
		}
	}
]
