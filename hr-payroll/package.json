{
	"name": "@template/hr-payroll",
	"description": "Multi-country, shift-aware HR and payroll workspace",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"check": "bolt check",
		"build": "bolt build --bank=${SEED_BANK:-../../seed_bank}",
		"dev": "bolt dev",
		"test": "bolt build --bank=${SEED_BANK:-../../seed_bank} && bolt test && pnpm test:node",
		"test:node": "node --experimental-strip-types --import ./scripts/ts-source-resolve.mjs --test 'tests/*.test.ts'",
		"format": "prettier --write .",
		"lint": "prettier --check ."
	},
	"dependencies": {
		"@iconify/svelte": "^5.2.2",
		"@internationalized/date": "^3.12.4",
		"@marcbachmann/cel-js": "8.0.0",
		"@norbital-ai/bolt": "0.0.166",
		"@norbital-ai/std": "0.0.166",
		"@norbital-ai/ui": "0.0.166",
		"@vladmandic/human": "3.3.6",
		"effect": "4.0.0-rc.112",
		"exceljs": "4.4.0",
		"onnxruntime-web": "1.23.2",
		"runed": "^0.37.1",
		"svelte": "^5.57.1",
		"svelte-sonner": "^1.2.1",
		"vite": "^8.3.2",
		"pdf-lib": "1.17.1",
		"@pdf-lib/fontkit": "1.1.1"
	},
	"devDependencies": {
		"@norbital-ai/bolt-server": "0.0.166",
		"@norbital-ai/doctor": "0.0.166",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^26.6.4",
		"@typescript/native": "npm:typescript@7.0.2",
		"happy-dom": "^20.14.5",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte-check": "^4.7.6",
		"typescript": "6.0.3",
		"vitest": "4.1.11",
		"pdfjs-dist": "6.4.299"
	}
}
