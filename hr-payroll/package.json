{
	"name": "@template/hr-payroll",
	"description": "Multi-country, shift-aware HR and payroll workspace",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dr": "pnpm exec norbital-doctor audit --root .",
		"format": "prettier --write .",
		"generate:import-templates": "node scripts/generate-import-templates.mjs",
		"lint": "prettier --check . && svelte-check --tsgo-experimental-api --tsconfig ./tsconfig.json",
		"sync": "bolt sync",
		"sync:watch": "bolt sync --watch",
		"test": "bolt sync && node scripts/verify-overtime-controls.mjs && node scripts/verify-payroll-xlsx.mjs && node scripts/verify-payroll-export-data.mjs && node scripts/verify-workbook-import.mjs && node scripts/verify-payroll-arithmetic.mjs && node scripts/verify-fixture-shapes.mjs && node --experimental-strip-types --import ./scripts/ts-source-resolve.mjs --test 'tests/*.test.ts'",
		"test:e2e": "bolt sync && vitest run --config vitest.e2e.config.ts",
		"test:e2e:headed": "PLAYWRIGHT_HEADED=1 pnpm test:e2e"
	},
	"dependencies": {
		"@iconify/svelte": "^5.2.2",
		"@internationalized/date": "^3.12.3",
		"@norbital-ai/bolt": "0.0.16",
		"@norbital-ai/bolt-protocol": "0.0.16",
		"@norbital-ai/std": "0.0.16",
		"@norbital-ai/ui": "0.0.16",
		"@vladmandic/human": "3.3.6",
		"effect": "4.0.0-rc.111",
		"exceljs": "4.4.0",
		"mode-watcher": "^1.1.0",
		"runed": "^0.37.1",
		"svelte": "^5.56.10",
		"svelte-sonner": "^1.2.1",
		"vite": "^8.2.2"
	},
	"devDependencies": {
		"@norbital-ai/bolt-server": "0.0.16",
		"@norbital-ai/doctor": "0.0.16",
		"@norbital-ai/test-utilities": "0.0.16",
		"@types/node": "^26.4.0",
		"@typescript/native": "npm:typescript@7.0.2",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte-check": "^4.7.6",
		"typescript": "6.0.3",
		"vitest": "4.1.11"
	}
}
