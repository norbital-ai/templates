node_modules/

# Generated workspace state. Migrations and doctor configuration are authored and stay tracked;
# everything else under .norbital is regenerable output and must never be committed.
.norbital/*
!.norbital/migrations/
!.norbital/migrations/**
!.norbital/config/
!.norbital/config/**

.pi/
.svelte-check/
.tmp/
.vite/

# Kiosk face-model binaries. Installed, not committed: `postinstall` copies them out of
# the pnpm-installed `@vladmandic/human` package (scripts/sync-human-models.mjs).
assets/models/human/*
!assets/models/human/.gitkeep
