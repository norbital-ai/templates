	{
		"id": "617ae8c6-9874-5f5b-808e-f6bc96bedf7a",
		"settings_id": "6a4dd28b-bfe0-5513-9e05-1fd42c33668c",
		"code": "SEPARATION_PAY",
		"name": "Separation pay",
		"authority": "Labor Code art.298: one month’s pay or one month per year of service, whichever is higher, on termination for installation of labour-saving devices or redundancy; art.298–299: half a month per year or one month, whichever is higher, on retrenchment, closure not due to serious losses, or disease. A fraction of at least six months counts as a year. Applied 2026-09-19 (2): Labor Code arts.298–299: one month’s pay per year of service (redundancy, the only authorised cause the exit reasons distinguish; a fraction of at least six months counts as a year), never less than one month.",
		"eligibility": "employment.exit_reason in [\"REDUNDANCY\", \"RETRENCHMENT\"]",
		"evidence": "NONE",
		"destination": "PAY",
		"direction": "ADD",
		"on_separation": true,
		"bands": [
			{
				"when": "person.employment.exit_reason == \"REDUNDANCY\"",
				"limit": null,
				"amount": "round_cent(person.terms.monthly_wage * (round_unit(person.employment.service_months / 12.0) > 1.0 ? round_unit(person.employment.service_months / 12.0) : 1.0))"
			},
			{
				"when": "",
				"limit": null,
				"amount": "round_cent(person.terms.monthly_wage * ((round_unit(person.employment.service_months / 12.0) > 1.0 ? round_unit(person.employment.service_months / 12.0) : 1.0) * 0.5 > 1.0 ? (round_unit(person.employment.service_months / 12.0) > 1.0 ? round_unit(person.employment.service_months / 12.0) : 1.0) * 0.5 : 1.0))"
			}
		],
		"fixed": false,
		"one_off": true
	},
	{
		"id": "4197dd92-b948-5d01-976b-1407bddf2a5e",
		"settings_id": "6a4dd28b-bfe0-5513-9e05-1fd42c33668c",
		"code": "RETIREMENT_PAY",
		"name": "Retirement pay",
		"authority": "RA 7641 (Labor Code art.302): an employee retiring at 60 to 65 after at least five years’ service, with no retirement plan, is paid half a month’s salary for every year of service — 22.5 days: fifteen days, the five-day service incentive leave and one twelfth of the 13th-month pay — a fraction of at least six months counting as a year. Applied 2026-09-19 (2): RA 7641 (Labor Code art.302): optional retirement from sixty and compulsory at sixty-five, after five years’ service — a person retiring past sixty-five is inside it; retail, service and agricultural establishments of not more than ten workers are outside (`company.facts.small_establishment`). One-half month salary is 22.5 days of the daily rate, the daily rate being the monthly basic on the person’s own factor (365 for the monthly-paid, 313 on a six-day week, 261 on five).",
		"eligibility": "employment.exit_reason == \"RETIREMENT\" && employee.age >= 60 && employment.service_months >= 60 && !(has(company.facts.small_establishment) && company.facts.small_establishment)",
		"evidence": "NONE",
		"destination": "PAY",
		"direction": "ADD",
		"on_separation": true,
		"bands": [
			{
				"when": "",
				"amount": "round_cent(22.5 * (person.terms.monthly_basic * 12.0 / (person.terms.payroll_group == \"MONTHLY\" ? 365.0 : person.terms.working_days_per_week >= 6.0 ? 313.0 : 261.0)) * round_unit(person.employment.service_months / 12.0))",
				"limit": null
			}
		],
		"fixed": false,
		"one_off": true
	},
