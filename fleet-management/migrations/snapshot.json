{
	"currency": "SGD",
	"tables": {
		"approval_request": {
			"fields": {
				"action": {
					"kind": "enum",
					"values": [
						"create",
						"update",
						"delete"
					]
				},
				"approver_teams": {
					"kind": "json",
					"shape": {
						"kind": "text",
						"many": true
					}
				},
				"approver_users": {
					"kind": "json",
					"shape": {
						"kind": "text",
						"many": true
					}
				},
				"closed_at": {
					"kind": "instant",
					"optional": true
				},
				"closed_by": {
					"kind": "text",
					"optional": true
				},
				"collection_name": {
					"kind": "text"
				},
				"created_at": {
					"kind": "instant"
				},
				"record_id": {
					"kind": "text"
				},
				"revision": {
					"default": 1,
					"kind": "int"
				},
				"status": {
					"kind": "enum",
					"values": [
						"ONGOING",
						"CHANGES_REQUESTED",
						"APPROVED",
						"REJECTED",
						"SUPERSEDED",
						"WITHDRAWN"
					]
				},
				"step": {
					"kind": "int"
				},
				"step_names": {
					"kind": "json",
					"shape": {
						"kind": "text",
						"many": true
					}
				},
				"steps": {
					"kind": "int"
				},
				"superseder_teams": {
					"kind": "json",
					"shape": {
						"kind": "text",
						"many": true
					}
				}
			},
			"key": "uuid",
			"search": {
				"text": [
					"collection_name"
				]
			},
			"unique": [
				{
					"fields": [
						"collection_name",
						"record_id"
					],
					"name": "one_ongoing_request",
					"where": {
						"status": {
							"eq": "ONGOING"
						}
					}
				}
			]
		},
		"drivers": {
			"audit": true,
			"fields": {
				"email": {
					"format": "email",
					"kind": "text",
					"optional": true
				},
				"employee_code": {
					"kind": "text"
				},
				"full_name": {
					"kind": "text"
				},
				"license_class": {
					"default": "class_4",
					"kind": "enum",
					"values": [
						"class_3",
						"class_4",
						"class_5",
						"hazmat",
						"crane"
					]
				},
				"license_expiry": {
					"kind": "date",
					"optional": true
				},
				"license_number": {
					"kind": "text",
					"optional": true
				},
				"notes": {
					"format": "markdown",
					"kind": "text",
					"optional": true
				},
				"phone": {
					"format": "phone",
					"kind": "text",
					"optional": true
				},
				"status": {
					"default": "active",
					"kind": "enum",
					"values": [
						"active",
						"on_leave",
						"suspended",
						"inactive"
					]
				}
			},
			"indexes": [
				{
					"on": [
						"status"
					]
				}
			],
			"record_label": "record.employee_code + ' · ' + record.full_name",
			"search": {
				"text": [
					"employee_code",
					"full_name",
					"license_number",
					"phone",
					"email"
				]
			},
			"unique": [
				{
					"fields": [
						"employee_code"
					],
					"import_key": true,
					"name": "employee_code"
				}
			]
		},
		"fleet_alerts": {
			"audit": true,
			"fields": {
				"alert_number": {
					"kind": "seq",
					"pattern": "ALT-{yyyy}-{000}"
				},
				"alert_type": {
					"kind": "enum",
					"values": [
						"overspeed",
						"geofence_enter",
						"geofence_exit",
						"offline",
						"route_delay"
					]
				},
				"geofence_id": {
					"inverse": "fleet_alerts",
					"kind": "ref",
					"on_delete": "set_null",
					"optional": true,
					"to": "geofences"
				},
				"limit_kmh": {
					"kind": "decimal",
					"optional": true,
					"scale": 1
				},
				"location": {
					"kind": "point",
					"optional": true
				},
				"measured_speed_kmh": {
					"kind": "decimal",
					"optional": true,
					"scale": 1
				},
				"recorded_at": {
					"kind": "instant"
				},
				"resolution_notes": {
					"format": "markdown",
					"kind": "text",
					"optional": true
				},
				"resolved_at": {
					"kind": "instant",
					"optional": true
				},
				"route_id": {
					"inverse": "fleet_alerts",
					"kind": "ref",
					"on_delete": "set_null",
					"optional": true,
					"to": "routes"
				},
				"severity": {
					"default": "warning",
					"kind": "enum",
					"values": [
						"info",
						"warning",
						"critical"
					]
				},
				"status": {
					"initial": "open",
					"kind": "state",
					"states": {
						"acknowledged": {
							"to": [
								"resolved",
								"open"
							]
						},
						"open": {
							"to": [
								"acknowledged",
								"resolved"
							]
						},
						"resolved": {
							"stamp": "resolved_at",
							"to": []
						}
					}
				},
				"summary": {
					"kind": "text"
				},
				"vehicle_id": {
					"inverse": "fleet_alerts",
					"kind": "ref",
					"on_delete": "cascade",
					"to": "vehicles"
				}
			},
			"indexes": [
				{
					"on": [
						"status",
						"severity",
						"recorded_at"
					]
				},
				{
					"on": [
						"vehicle_id",
						"status"
					]
				}
			],
			"locks": {
				"resolved_locked": {
					"except": [
						"resolution_notes"
					],
					"where": {
						"status": {
							"eq": "resolved"
						}
					}
				}
			},
			"record_label": "record.alert_number != null ? record.alert_number + ' · ' + record.summary : record.summary",
			"search": {
				"text": [
					"alert_number",
					"summary",
					"resolution_notes"
				]
			}
		},
		"geofences": {
			"audit": true,
			"check": {
				"positive_speed_limit": {
					"or": [
						{
							"speed_limit_kmh": {
								"is_null": true
							}
						},
						{
							"speed_limit_kmh": {
								"gt": 0
							}
						}
					]
				}
			},
			"fields": {
				"active": {
					"default": true,
					"kind": "bool"
				},
				"alert_on_enter": {
					"default": false,
					"kind": "bool"
				},
				"alert_on_exit": {
					"default": false,
					"kind": "bool"
				},
				"center": {
					"kind": "point"
				},
				"code": {
					"kind": "text"
				},
				"name": {
					"kind": "text"
				},
				"notes": {
					"format": "markdown",
					"kind": "text",
					"optional": true
				},
				"radius_m": {
					"default": 250,
					"kind": "int",
					"min": 25
				},
				"speed_limit_kmh": {
					"kind": "decimal",
					"optional": true,
					"scale": 1
				},
				"zone_type": {
					"default": "depot",
					"kind": "enum",
					"values": [
						"depot",
						"job_site",
						"customer",
						"corridor",
						"restricted"
					]
				}
			},
			"indexes": [
				{
					"on": [
						"active",
						"zone_type"
					]
				}
			],
			"record_label": "record.code + ' · ' + record.name",
			"search": {
				"text": [
					"code",
					"name",
					"notes"
				]
			},
			"unique": [
				{
					"fields": [
						"code"
					],
					"import_key": true,
					"name": "code"
				}
			]
		},
		"requestor": {
			"fields": {
				"approval_request_id": {
					"kind": "ref",
					"to": "approval_request"
				},
				"user_id": {
					"kind": "text"
				}
			},
			"key": "text",
			"record_label": "record.user_id"
		},
		"routes": {
			"audit": true,
			"check": {
				"valid_window": {
					"planned_arrival": {
						"gte": {
							"field": "planned_departure"
						}
					}
				}
			},
			"fields": {
				"actual_arrival": {
					"kind": "instant",
					"optional": true
				},
				"actual_departure": {
					"kind": "instant",
					"optional": true
				},
				"actual_distance_km": {
					"kind": "decimal",
					"optional": true,
					"scale": 2
				},
				"cargo_notes": {
					"format": "markdown",
					"kind": "text",
					"optional": true
				},
				"destination_location": {
					"kind": "point"
				},
				"destination_name": {
					"kind": "text"
				},
				"driver_id": {
					"inverse": "routes",
					"kind": "ref",
					"on_delete": "set_null",
					"optional": true,
					"to": "drivers"
				},
				"eta_minutes": {
					"kind": "int",
					"min": 0,
					"optional": true
				},
				"max_speed_recorded_kmh": {
					"kind": "decimal",
					"optional": true,
					"scale": 1
				},
				"origin_location": {
					"kind": "point"
				},
				"origin_name": {
					"kind": "text"
				},
				"planned_arrival": {
					"kind": "instant"
				},
				"planned_departure": {
					"kind": "instant"
				},
				"planned_distance_km": {
					"default": 0,
					"kind": "decimal",
					"scale": 2
				},
				"route_number": {
					"kind": "seq",
					"pattern": "RTE-{yyyy}-{000}"
				},
				"status": {
					"initial": "planned",
					"kind": "state",
					"states": {
						"arrived": {
							"to": [
								"completed"
							]
						},
						"cancelled": {
							"to": []
						},
						"completed": {
							"to": []
						},
						"dispatched": {
							"to": [
								"en_route",
								"cancelled"
							]
						},
						"en_route": {
							"to": [
								"arrived",
								"completed",
								"cancelled"
							]
						},
						"planned": {
							"to": [
								"dispatched",
								"en_route",
								"cancelled"
							]
						}
					}
				},
				"title": {
					"kind": "text"
				},
				"vehicle_id": {
					"inverse": "routes",
					"kind": "ref",
					"on_delete": "restrict",
					"to": "vehicles"
				},
				"waypoints": {
					"kind": "custom",
					"of": "route_waypoints",
					"optional": true
				}
			},
			"indexes": [
				{
					"on": [
						"vehicle_id",
						"status"
					]
				},
				{
					"on": [
						"status",
						"planned_departure"
					]
				}
			],
			"locks": {
				"closed_locked": {
					"except": [
						"cargo_notes"
					],
					"where": {
						"status": {
							"in": [
								"completed",
								"cancelled"
							]
						}
					}
				}
			},
			"record_label": "record.route_number != null ? record.route_number + ' · ' + record.title : record.title",
			"search": {
				"text": [
					"route_number",
					"title",
					"origin_name",
					"destination_name",
					"cargo_notes"
				]
			}
		},
